generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------------------------------
// Multi-shop (multi-tenant) model
//
// Every business table carries a `shopId`. PostgreSQL row-level security (see the migration) restricts each request to
// the rows of one shop, so even a query that forgets a filter cannot see or change another shop's data. The default
// for `shopId` is the shop of the current request (`app.shop_id`), so inserts are stamped automatically.
// ---------------------------------------------------------------------------------------------------------------------

enum Role {
  PLATFORM_OWNER // runs the platform: creates shops and their first admin. Belongs to no shop.
  ADMIN          // a shop's administrator: manages that shop's staff, settings and everything else in it
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT_ADD
  ADJUSTMENT_REMOVE
  DAMAGE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model Shop {
  id                        String   @id @default(cuid())
  name                      String
  address                   String   @default("")
  phone                     String   @default("")
  receiptFooter             String   @default("Thank you for shopping with us!")
  cashierMaxDiscountPercent Int      @default(10)
  currency                  String   @default("UGX") // reserved: amounts are whole units of this currency
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  users              User[]
  categories         Category[]
  products           Product[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleItems          SaleItem[]
  saleReturns        SaleReturn[]
  saleReturnItems    SaleReturnItem[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  auditLogs          AuditLog[]
  receiptCounters    ReceiptCounter[]
}

model User {
  id           String   @id @default(cuid())
  // Null only for the platform owner. One email belongs to exactly one shop (email is globally unique).
  shopId       String?
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop           Shop?           @relation(fields: [shopId], references: [id])
  sales          Sale[]
  stockMovements StockMovement[]
  returns        SaleReturn[]
  purchaseOrders PurchaseOrder[]
  auditLogs      AuditLog[]
  authTokens     AuthToken[]

  @@index([shopId, role])
}

model Category {
  id          String   @id @default(cuid())
  shopId      String   @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  name        String
  description String?
  createdAt   DateTime @default(now())

  shop     Shop      @relation(fields: [shopId], references: [id])
  products Product[]

  @@unique([shopId, name])
}

model Product {
  id          String   @id @default(cuid())
  shopId      String   @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  sku         String
  barcode     String?
  name        String
  description String?
  // Images live in the DB (served by /api/products/[id]/image) because serverless hosts have no persistent disk.
  imageData   Bytes?
  imageType   String?
  categoryId  String?
  // Money is stored as whole currency units (integers) to avoid floating point errors.
  costPrice   Int
  sellPrice   Int
  stock       Int      @default(0)
  minStock    Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop           Shop                @relation(fields: [shopId], references: [id])
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  poItems        PurchaseOrderItem[]

  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  @@index([shopId, name])
  @@index([categoryId])
}

model StockMovement {
  id         String            @id @default(cuid())
  shopId     String            @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  productId  String
  type       StockMovementType
  // Signed: positive adds stock, negative removes it.
  quantity   Int
  stockAfter Int
  reason     String?
  reference  String?
  userId     String?
  createdAt  DateTime          @default(now())

  shop    Shop    @relation(fields: [shopId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([shopId, productId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  shopId        String        @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  receiptNo     String
  cashierId     String
  customerName  String?
  customerPhone String?
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  paymentMethod PaymentMethod
  amountPaid    Int
  changeGiven   Int           @default(0)
  status        SaleStatus    @default(COMPLETED)
  note          String?
  createdAt     DateTime      @default(now())
  // Set by the till: a unique id per sale so a retried or late-synced sale is never recorded twice.
  clientId      String?
  // When the sale happened on the device, if it was made offline and uploaded later.
  offlineAt     DateTime?
  // Offline sales are always accepted (the goods already left the shop) but are flagged for a manager when the server
  // had to deviate from what the till showed: stock went negative, a price changed, a discount exceeded the limit.
  needsReview   Boolean       @default(false)
  reviewNote    String?

  shop    Shop         @relation(fields: [shopId], references: [id])
  cashier User         @relation(fields: [cashierId], references: [id])
  items   SaleItem[]
  returns SaleReturn[]

  @@unique([shopId, receiptNo])
  @@unique([shopId, clientId])
  @@index([shopId, createdAt])
  @@index([shopId, cashierId, createdAt])
  @@index([shopId, paymentMethod])
}

model SaleItem {
  id           String @id @default(cuid())
  shopId       String @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  saleId       String
  productId    String
  // Snapshots so later price changes never alter historical sales or profit.
  productName  String
  sku          String
  quantity     Int
  unitPrice    Int
  unitCost     Int
  lineDiscount Int    @default(0)
  lineTotal    Int

  shop    Shop             @relation(fields: [shopId], references: [id])
  sale    Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id])
  returns SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model SaleReturn {
  id          String   @id @default(cuid())
  shopId      String   @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  saleId      String
  processedBy String
  reason      String?
  refundTotal Int
  createdAt   DateTime @default(now())

  shop  Shop             @relation(fields: [shopId], references: [id])
  sale  Sale             @relation(fields: [saleId], references: [id])
  user  User             @relation(fields: [processedBy], references: [id])
  items SaleReturnItem[]

  @@index([saleId])
}

model SaleReturnItem {
  id           String @id @default(cuid())
  shopId       String @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  returnId     String
  saleItemId   String
  quantity     Int
  refundAmount Int

  shop       Shop       @relation(fields: [shopId], references: [id])
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  shopId    String   @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  shop           Shop            @relation(fields: [shopId], references: [id])
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  shopId      String              @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  poNumber    String
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  total       Int                 @default(0)
  note        String?
  invoiceNo   String?
  createdById String
  createdAt   DateTime            @default(now())
  receivedAt  DateTime?

  shop      Shop                @relation(fields: [shopId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@unique([shopId, poNumber])
}

model PurchaseOrderItem {
  id          String @id @default(cuid())
  shopId      String @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  orderId     String
  productId   String
  quantity    Int
  unitCost    Int
  receivedQty Int    @default(0)

  shop    Shop          @relation(fields: [shopId], references: [id])
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  // Set by the code that writes the entry; null for platform-level events (e.g. a sign-in attempt for an unknown email).
  shopId    String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  shop Shop? @relation(fields: [shopId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
  @@index([action, createdAt])
}

// One row per shop per Kampala day; incremented atomically so concurrent sales never collide on a receipt number.
model ReceiptCounter {
  shopId String @default(dbgenerated("current_setting('app.shop_id'::text, true)"))
  day    String // yyyy-mm-dd
  last   Int

  shop Shop @relation(fields: [shopId], references: [id])

  @@id([shopId, day])
}

enum TokenPurpose {
  INVITE
  RESET
}

// One-time links for setting or resetting a password. Only a SHA-256 hash of the token is stored. Never read by shop
// code: it is reached only through platform-level access (see src/lib/tokens.ts).
model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}
