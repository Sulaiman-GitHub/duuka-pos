# Copy to .env for local development. Never commit the real .env.

# PostgreSQL connection string (Neon, Vercel Postgres, or a local server)
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos"

# Optional: a direct (non-pooled) connection used for migrations when your host provides one (Neon does).
# DATABASE_URL_UNPOOLED=""

# Secret used to sign login cookies. At least 32 random characters:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-of-32-or-more-characters"

# Optional defaults for receipts until an admin saves the Settings page
# BUSINESS_NAME="Duuka Mart"
# BUSINESS_ADDRESS="Kansanga, Kampala, Uganda"
# BUSINESS_PHONE="+256 000 000 000"
# RECEIPT_FOOTER="Thank you for shopping with us!"

# DANGER - one-off: set to exactly YES-DELETE-EVERYTHING for a single deploy to wipe the database and reload
# the demo data, then REMOVE it again. Left set, every deploy would wipe the data.
# RESET_DEMO_DATA=""
