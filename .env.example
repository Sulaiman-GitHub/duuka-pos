# Copy to .env for local development. Never commit the real .env.

# PostgreSQL connection string (Neon, or a local server). The database user needs the CREATEROLE privilege the first
# time migrations run (they create the restricted `duuka_app` role); Neon's default owner role has it.
DATABASE_URL="postgresql://pos:pos@localhost:5432/duuka"

# Optional: a direct (non-pooled) connection used for migrations when your host provides one (Neon does).
# DATABASE_URL_UNPOOLED=""

# Secret used to sign login cookies. At least 32 random characters:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-of-32-or-more-characters"

# PRODUCTION: the first platform-owner account, created on deploy if none exists yet. Use a strong password
# (12+ characters), then you may remove these variables. This account creates shops and their administrators.
# PLATFORM_OWNER_EMAIL="you@example.com"
# PLATFORM_OWNER_PASSWORD=""
# PLATFORM_OWNER_NAME="Your Name"

# DEVELOPMENT / STAGING ONLY: set to 1 to load demo shops into an EMPTY database on deploy. Never set in production.
# DEMO_DATA=1
